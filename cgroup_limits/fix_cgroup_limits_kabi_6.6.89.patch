Subject: [PATCH] cgroup, sched: preserve SM8750 KMI with CPU and PID limits

Target: oneplus/sm8750_v_16.0.0_oneplus_13_6.6.89
Frozen configuration: CONFIG_CFS_BANDWIDTH=n, CONFIG_CGROUP_PIDS=n

Keep existing subsystem IDs and ABI-visible cgroup arrays unchanged.
Store PIDS slots in private allocation tails, with separate storage for
static boot objects. Route controller iteration through the active count.

Keep the entire public task_group, cfs_rq and rq layouts unchanged,
including ALL Android KABI and vendor/OEM reserves. SM8750 vendor
oplus_bsp_schedtune uses task_group reserve 1 for its own pointer, so
reserve slots must not be treated as unused storage.

Store CFS group state after task_group in its private slab allocation;
keep root state and rq CSD state in separate static storage. Allocate
per-group CPU state before publication and free it after the existing
timer, CSD and RCU teardown. This preserves vendor-owned reserved data.

This patch retains symbol version checking. It targets KMI frozen with
both options disabled and CGROUPS/CGROUP_SCHED/FAIR_GROUP_SCHED enabled.
It must not be applied to a KMI frozen with either option already enabled.

diff --git a/include/linux/cgroup-defs.h b/include/linux/cgroup-defs.h
index 87c57b18b899..fe5067c6555c 100644
--- a/include/linux/cgroup-defs.h
+++ b/include/linux/cgroup-defs.h
@@ -41,12 +41,26 @@ struct poll_table_struct;
 
 /* define the enumeration of all cgroup subsystems */
 #define SUBSYS(_x) _x ## _cgrp_id,
+#define CGROUP_SUBSYS_KABI
 enum cgroup_subsys_id {
 #include <linux/cgroup_subsys.h>
 	CGROUP_SUBSYS_COUNT,
 };
+#undef CGROUP_SUBSYS_KABI
 #undef SUBSYS
 
+/*
+ * Keep the original IDs and array bounds when enabling PIDS on a kernel
+ * whose Android KMI was frozen with CONFIG_CGROUP_PIDS=n.  Only cgroup core
+ * walks the extra runtime slot; ABI-visible arrays retain their old bounds.
+ */
+#ifdef CONFIG_CGROUP_PIDS
+enum { pids_cgrp_id = CGROUP_SUBSYS_COUNT };
+#define CGROUP_SUBSYS_COUNT_ACTIVE (CGROUP_SUBSYS_COUNT + 1)
+#else
+#define CGROUP_SUBSYS_COUNT_ACTIVE CGROUP_SUBSYS_COUNT
+#endif
+
 /* bits in struct cgroup_subsys_state flags field */
 enum {
 	CSS_NO_REF	= (1 << 0), /* no reference counting for this css */
